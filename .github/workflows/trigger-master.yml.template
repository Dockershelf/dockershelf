name: Trigger (master branch)

on:
  workflow_dispatch:
    inputs:
      debian:
        description: Build debian images
        type: boolean
        default: true
      latex:
        description: Build latex images
        type: boolean
        default: true
      python:
        description: Build python images
        type: boolean
        default: true
      node:
        description: Build node images
        type: boolean
        default: true
      go:
        description: Build go images
        type: boolean
        default: true

jobs:
  build:
    name: Build
    runs-on: ubuntu-24.04
    strategy:
      fail-fast: false
      matrix:
        include:
%%MATRIX%%

    steps:
      # matrix is unavailable in job-level if; filter per step instead
      - name: Checkout repo
        if: >
          (startsWith(matrix.docker-image-name, 'dockershelf/debian:') && inputs.debian) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/latex:') && inputs.latex) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/python:') && inputs.python) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/node:') && inputs.node) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/go:') && inputs.go)
        uses: actions/checkout@v7
        with:
          ref: master
          fetch-depth: 0

      - name: Set up QEMU
        if: >
          (startsWith(matrix.docker-image-name, 'dockershelf/debian:') && inputs.debian) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/latex:') && inputs.latex) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/python:') && inputs.python) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/node:') && inputs.node) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/go:') && inputs.go)
        uses: docker/setup-qemu-action@v4

      - name: Set up Docker Buildx
        if: >
          (startsWith(matrix.docker-image-name, 'dockershelf/debian:') && inputs.debian) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/latex:') && inputs.latex) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/python:') && inputs.python) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/node:') && inputs.node) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/go:') && inputs.go)
        uses: docker/setup-buildx-action@v4
        with:
          # Debian images need RUN --security=insecure (debootstrap mounts /proc)
          buildkitd-flags: --allow-insecure-entitlement security.insecure

      - if: >
          (startsWith(matrix.docker-image-name, 'dockershelf/debian:') && inputs.debian) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/latex:') && inputs.latex) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/python:') && inputs.python) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/node:') && inputs.node) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/go:') && inputs.go)
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: "3.2"
          bundler-cache: true

      - name: Building docker image
        if: >
          (startsWith(matrix.docker-image-name, 'dockershelf/debian:') && inputs.debian) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/latex:') && inputs.latex) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/python:') && inputs.python) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/node:') && inputs.node) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/go:') && inputs.go)
        env:
          DOCKER_IMAGE_NAME: ${{ matrix.docker-image-name }}
          DEBIAN_SUITE: ${{ matrix.debian-suite }}
          DH_USERNAME: ${{ secrets.DH_USERNAME }}
          DH_PASSWORD: ${{ secrets.DH_PASSWORD }}
        run: |
          bash build-image.sh "${DOCKER_IMAGE_NAME}" "${DEBIAN_SUITE}" "${DH_USERNAME}" "${DH_PASSWORD}" "master"

      - name: Testing docker image
        if: >
          (startsWith(matrix.docker-image-name, 'dockershelf/debian:') && inputs.debian) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/latex:') && inputs.latex) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/python:') && inputs.python) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/node:') && inputs.node) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/go:') && inputs.go)
        env:
          DOCKER_IMAGE_NAME: ${{ matrix.docker-image-name }}
          DOCKER_IMAGE_EXTRA_TAGS: ${{ matrix.docker-image-extra-tags }}
        run: |
          bash test-image.sh "${DOCKER_IMAGE_NAME}" "master"

      - name: Pushing docker image
        if: >
          (startsWith(matrix.docker-image-name, 'dockershelf/debian:') && inputs.debian) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/latex:') && inputs.latex) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/python:') && inputs.python) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/node:') && inputs.node) ||
          (startsWith(matrix.docker-image-name, 'dockershelf/go:') && inputs.go)
        env:
          DOCKER_IMAGE_NAME: ${{ matrix.docker-image-name }}
          DOCKER_IMAGE_EXTRA_TAGS: ${{ matrix.docker-image-extra-tags }}
          DH_USERNAME: ${{ secrets.DH_USERNAME }}
          DH_PASSWORD: ${{ secrets.DH_PASSWORD }}
        run: |
          bash push-image.sh "${DOCKER_IMAGE_NAME}" "${DH_USERNAME}" "${DH_PASSWORD}" "${DOCKER_IMAGE_EXTRA_TAGS}" "master"
