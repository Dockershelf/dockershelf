# Host user/group for docker-compose build (match your uid/gid; defaults 1000)
UID=1000
GID=1000

# Docker Hub credentials (required for scripts/build-all-images.sh and scripts/delete-stale.sh)
DH_USERNAME=your_dockerhub_username
DH_PASSWORD=your_dockerhub_password_or_token

# Docker Hub session cookie (required for scripts/delete-stale.sh untagged cleanup)
# Copy from browser devtools while logged in to hub.docker.com
DOCKER_HUB_COOKIE="sessionid=...; csrftoken=...; ..."

# Space-separated Docker Hub repositories for delete-stale.sh
REPO="dockershelf/python dockershelf/node dockershelf/go dockershelf/debian dockershelf/latex"

# Optional: scripts/build-all-images.sh
# BRANCH=develop
# SKIP_TESTS=false

# Optional: scripts/delete-stale.sh
# MAX_UNTAGGED_LIMIT=100
# MAX_PAGINATION_REQUESTS=150
